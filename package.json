{
  "name": "fast-document-viewer",
  "version": "0.8.2",
  "description": "%extension.description%",
  "main": "./extension.js",
  "icon": "media/icon.png",
  "license": "MIT",
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^14.3.3",
    "markdown-it-task-lists": "^2.1.1"
  },
  "displayName": "%extension.displayName%",
  "publisher": "toqitahamid",
  "repository": {
    "type": "git",
    "url": "https://github.com/toqitahamid/fast-document-viewer.git"
  },
  "keywords": [
    "markdown",
    "pdf",
    "html",
    "latex",
    "tex",
    "viewer",
    "preview",
    "remote-ssh",
    "katex",
    "document",
    "paper"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:paperMd.viewer",
    "onLanguage:markdown",
    "onLanguage:html",
    "onLanguage:latex",
    "onLanguage:tex",
    "onCommand:paperMd.openFollowPanel",
    "onStartupFinished"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "paperMd.viewer",
        "displayName": "%customEditor.displayName%",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "paperMd.enableAll",
        "title": "%command.enableAll%",
        "category": "%command.category%"
      },
      {
        "command": "paperMd.showPaper",
        "title": "%command.showPaper%",
        "category": "%command.category%",
        "shortTitle": "%command.showPaper.short%",
        "icon": "$(open-preview)"
      },
      {
        "command": "paperMd.openFollowPanel",
        "title": "%command.openFollowPanel%",
        "category": "%command.category%"
      },
      {
        "command": "paperMd.openAsText",
        "title": "%command.openAsText%",
        "category": "%command.category%",
        "shortTitle": "%command.openAsText.short%",
        "icon": "$(edit)"
      },
      {
        "command": "paperMd.recompileTex",
        "title": "%command.recompileTex%",
        "category": "%command.category%"
      },
      {
        "command": "paperMd.openTexLog",
        "title": "%command.openTexLog%",
        "category": "%command.category%"
      }
    ],
    "configuration": {
      "title": "Fast Document Viewer",
      "properties": {
        "paperMd.followPanel.autoOpen": {
          "type": "boolean",
          "default": false,
          "order": 1,
          "description": "%setting.paperMd.followPanel.autoOpen.desc%",
          "markdownDescription": "%setting.paperMd.followPanel.autoOpen.md%"
        },
        "paperMd.followPanel.replaceTextTab": {
          "type": "boolean",
          "default": false,
          "order": 2,
          "description": "%setting.paperMd.followPanel.replaceTextTab.desc%",
          "markdownDescription": "%setting.paperMd.followPanel.replaceTextTab.md%"
        },
        "paperMd.pdf.enabled": {
          "type": "boolean",
          "default": false,
          "order": 3,
          "description": "%setting.paperMd.pdf.enabled.desc%",
          "markdownDescription": "%setting.paperMd.pdf.enabled.md%"
        },
        "paperMd.html.enabled": {
          "type": "boolean",
          "default": false,
          "order": 4,
          "description": "%setting.paperMd.html.enabled.desc%",
          "markdownDescription": "%setting.paperMd.html.enabled.md%"
        },
        "paperMd.tex.enabled": {
          "type": "boolean",
          "default": false,
          "order": 5,
          "description": "%setting.paperMd.tex.enabled.desc%",
          "markdownDescription": "%setting.paperMd.tex.enabled.md%"
        },
        "paperMd.tex.mode": {
          "type": "string",
          "default": "html",
          "order": 6,
          "description": "%setting.paperMd.tex.mode.desc%",
          "markdownDescription": "%setting.paperMd.tex.mode.md%",
          "enum": [
            "html",
            "compile"
          ],
          "enumDescriptions": [
            "%setting.tex.mode.html%",
            "%setting.tex.mode.compile%"
          ]
        },
        "paperMd.tex.texPath": {
          "type": "string",
          "default": "",
          "order": 7,
          "description": "%setting.paperMd.tex.texPath.desc%",
          "markdownDescription": "%setting.paperMd.tex.texPath.md%",
          "scope": "machine"
        },
        "paperMd.tex.maxMirrorMB": {
          "type": "number",
          "default": 200,
          "order": 8,
          "description": "%setting.paperMd.tex.maxMirrorMB.desc%",
          "markdownDescription": "%setting.paperMd.tex.maxMirrorMB.md%",
          "minimum": 1
        },
        "paperMd.allowRemoteImages": {
          "type": "boolean",
          "default": true,
          "order": 9,
          "description": "%setting.paperMd.allowRemoteImages.desc%",
          "markdownDescription": "%setting.paperMd.allowRemoteImages.md%"
        },
        "paperMd.customCss": {
          "type": "string",
          "default": "",
          "order": 10,
          "description": "%setting.paperMd.customCss.desc%",
          "markdownDescription": "%setting.paperMd.customCss.md%",
          "scope": "machine"
        },
        "paperMd.theme": {
          "type": "string",
          "enum": [
            "paper",
            "auto"
          ],
          "default": "paper",
          "order": 11,
          "enumDescriptions": [
            "%setting.paperMd.theme.paper%",
            "%setting.paperMd.theme.auto%"
          ],
          "markdownDescription": "%setting.paperMd.theme.md%",
          "description": "%setting.paperMd.theme.desc%"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "paperMd.openAsText",
          "when": "activeWebviewPanelId == 'paperMd.follow' || activeWebviewPanelId == 'paperMd.html'",
          "group": "navigation"
        },
        {
          "command": "paperMd.showPaper",
          "when": "!activeWebviewPanelId && resourceExtname =~ /^\\.(md|markdown|tex|html?)$/",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "paperMd.showPaper",
          "when": "resourceExtname =~ /^\\.(md|markdown|tex|html?)$/"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "paperMd.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "enable",
            "title": "%walkthrough.enable.title%",
            "description": "%walkthrough.enable.desc%",
            "media": {
              "markdown": "media/walkthrough/enable.md"
            },
            "completionEvents": [
              "onCommand:paperMd.enableAll"
            ]
          },
          {
            "id": "open",
            "title": "%walkthrough.open.title%",
            "description": "%walkthrough.open.desc%",
            "media": {
              "markdown": "media/walkthrough/open.md"
            },
            "completionEvents": [
              "onStepSelected"
            ]
          },
          {
            "id": "sides",
            "title": "%walkthrough.sides.title%",
            "description": "%walkthrough.sides.desc%",
            "media": {
              "markdown": "media/walkthrough/sides.md"
            },
            "completionEvents": [
              "onStepSelected"
            ]
          },
          {
            "id": "compile",
            "title": "%walkthrough.compile.title%",
            "description": "%walkthrough.compile.desc%",
            "media": {
              "markdown": "media/walkthrough/compile.md"
            },
            "completionEvents": [
              "onStepSelected"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check extension.js && node --check src/render.js && node --check src/tex.js && node --check src/texroot.js && node --check src/texcompile.js && node --check media/main.js",
    "package": "vsce package"
  },
  "homepage": "https://github.com/toqitahamid/fast-document-viewer#readme",
  "bugs": {
    "url": "https://github.com/toqitahamid/fast-document-viewer/issues"
  },
  "qna": "marketplace",
  "galleryBanner": {
    "color": "#f4efe6",
    "theme": "light"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrusted%",
      "restrictedConfigurations": [
        "paperMd.tex.mode",
        "paperMd.tex.texPath"
      ]
    }
  }
}
